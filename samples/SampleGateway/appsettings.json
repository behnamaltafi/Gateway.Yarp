{
  "AllowedHosts": "localhost",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "Gateway": {
    "OpenApi": {
      "Enabled": true,
      "SwaggerEnabled": true,
      "ScalarEnabled": true,
      "JsonEnabled": true,
      "AllowAnonymousInDevelopment": false
    },
    "Dashboard": {
      "RoutePrefix": "aneiang",
      "Locale": "en-US"
    },
    "Storage": {
      "Provider": "Sqlite", 
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db" },
      "Redis": {
        "ConnectionString": "localhost:6379",
        "Prefix": "aneiang:",
        "Database": 0
      }
    },
    "Deployment": {
      "Mode": "AllInOne",
      "RequireLoopbackForDashboard": true,
      "HealthCheck": { "Enabled": true },
      "HotReload": { "Enabled": true }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "sample-documentation": {
        "ClusterId": "sample-local-service",
        "Match": { "Path": "/demo/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/local-service/{**rest}" }]
      },
      "bonak-market": {
        "ClusterId": "BonakMarket",
        "Match": { "Path": "/BonakMarket/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/BonakMarket" }]
      }
    },
    "Clusters": {
      "sample-local-service": {
        "Destinations": { "local": { "Address": "http://localhost:5001/" } }
      },
      "BonakMarket": {
        "Destinations": { "local": { "Address": "http://localhost:5114/" } }
      }
    }
  },
  "YarpOpenApi": {
    "MergeDocuments": false,
    "CacheDuration": "00:00:30",
    "FetchTimeout": "00:00:10",
    "Clusters": {
      "sample-local-service": {
        "Title": "Sample Local Service",
        "OpenApiPath": "/openapi/v1.json",
        "AddOnlyPublishedPaths": true
      },
      "BonakMarket": {
        "Title": "BonakMarket API",
        "OpenApiPath": "/swagger/v1/swagger.json",
        "AddOnlyPublishedPaths": true
      }
    }
  },
  "AI": {
    "Enabled": false,
    "Provider": "deepseek",
    "BaseUrl": "https://api.deepseek.com/v1",
    "ChatModel": "deepseek-v4-flash",
    "AnalysisModel": "deepseek-v4-flash",
    "MaxTokens": 4096,
    "Temperature": 0.7,
    "MaxHistory": 20,
    "ReasoningEffort": "auto",
    "UseCache": true,
    "BgAnalysis": false,
    "EnhanceNotif": false,
    "Fallback": {
      "Enabled": false,
      "Provider": "",
      "BaseUrl": "",
      "Model": ""
    },
    "McpServer": {
      "Enabled": false,
      "Port": 8090
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Gateway": { "Url": "https://localhost:5200" },
      "Grpc": { "Url": "https://localhost:5201", "Protocols": "Http2" }
    }
  }
}
