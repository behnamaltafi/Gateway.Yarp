{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Yarp.ReverseProxy": "Debug"
    }
  },
  "Gateway": {
    "OpenApi": {
      "Enabled": true,
      "SwaggerEnabled": true,
      "ScalarEnabled": true,
      "JsonEnabled": true
    },
    "Dashboard": {
      "RoutePrefix": "aneiang",
      "EnableProxyResponseBodyCapture": true,
      "Auth": {
        "AuthMode": "DefaultJwt",
        "JwtPassword": "demo123"
      }
    },
    "Storage": {
      "Provider": "Sqlite", 
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db;Password=123456" },
      "Redis": {
        "ConnectionString": "localhost:6379",
        "Prefix": "aneiang:",
        "Database": 0
      }
    },
    "Deployment": {
      "Mode": "AllInOne",
      "RequireLoopbackForDashboard": false,
      "HealthCheck": { "Enabled": true },
      "HotReload": { "Enabled": true }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "sample-documentation": {
        "ClusterId": "sample-local-service",
        "Match": { "Path": "/demo/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/local-service/{**rest}" }]
      }
    },
    "Clusters": {
      "sample-local-service": {
        "Destinations": { "local": { "Address": "http://localhost:5001/" } }
      }
    }
  },
  "YarpOpenApi": {
    "MergeDocuments": true,
    "CacheDuration": "00:00:30",
    "FetchTimeout": "00:00:10",
    "Clusters": {
      "sample-local-service": {
        "Title": "Sample Local Service",
        "OpenApiPath": "/openapi/v1.json",
        "AddOnlyPublishedPaths": true
      }
    },
    "MergedDocument": {
      "Title": "Gateway APIs",
      "Version": "1.0.0",
      "RenameDuplicateSchemas": true
    }
  },
  "AI": {
    "Enabled": false,
    "Provider": "deepseek",
    "ApiKey": "",
    "BaseUrl": "https://api.deepseek.com/v1",
    "ChatModel": "deepseek-v4-flash",
    "AnalysisModel": "deepseek-v4-flash",
    "MaxTokens": 4096,
    "Temperature": 0.7,
    "MaxHistory": 20,
    "ReasoningEffort": "auto",
    "UseCache": true,
    "BgAnalysis": false,
    "EnhanceNotif": false,
    "Fallback": {
      "Enabled": false,
      "Provider": "",
      "ApiKey": "",
      "BaseUrl": "",
      "Model": ""
    },
    "McpServer": {
      "Enabled": false,
      "Port": 8090
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Gateway": { "Url": "http://0.0.0.0:5200" },
      "Grpc": { "Url": "http://0.0.0.0:5201", "Protocols": "Http2" }
    }
  }
}
