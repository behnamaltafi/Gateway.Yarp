{
  "_comment": "Business proxy and loopback HTTPS machine administration. Dashboard UI is disabled.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Proxy": { "Url": "http://0.0.0.0:80" },
      "Admin": { "Url": "https://localhost:5001" }
    }
  },
  "Gateway": {
    "Deployment": {
      "Mode": "ProxyOnly",
      "EndpointRoles": {
        "Proxy": "Proxy",
        "Admin": "Admin"
      },
      "RequireLoopbackForAdmin": true,
      "HealthCheck": {
        "Enabled": true
      }
    },
    "Storage": {
      "Provider": "Sqlite",
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db" }
    }
  }
}
