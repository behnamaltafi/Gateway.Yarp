{
  "_comment": "Loopback HTTPS Dashboard without business forwarding.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Dashboard": { "Url": "https://localhost:5000" }
    }
  },
  "Gateway": {
    "Deployment": {
      "Mode": "DashboardOnly",
      "EndpointRoles": {
        "Dashboard": "Dashboard"
      },
      "RequireLoopbackForDashboard": true,
      "HealthCheck": {
        "Enabled": true,
        "Path": "/health",
        "ReadyPath": "/ready",
        "LivePath": "/live"
      },
      "HotReload": { "Enabled": true }
    },
    "Dashboard": {
      "RoutePrefix": "aneiang",
      "Locale": "en-US"
    },
    "Storage": {
      "Provider": "Sqlite",
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db" }
    }
  }
}
