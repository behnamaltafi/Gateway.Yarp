{
  "_comment": "Single HTTPS listener for the Dashboard and business proxy.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "Dashboard": {
      "RoutePrefix": "aneiang",
      "Locale": "en-US"
    },
    "Storage": {
      "Provider": "Sqlite",
      "Sqlite": { "ConnectionString": "Data Source=gateway-store.db" }
    }
  },
  "Urls": "https://localhost:5200"
}
