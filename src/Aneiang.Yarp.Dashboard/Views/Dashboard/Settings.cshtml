@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "Settings" : "System Settings";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var keycloakSso = Context.RequestServices.GetService(typeof(Aneiang.Yarp.Iam.IamManagementAuthorization)) is not null;
}

<div id="settings-app">
    <div class="page-help-bar" id="settings-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="page.help.settings">System settings include account security, log collection and data persistence policies, plus system runtime information.</span>
        <button class="help-close" onclick="document.getElementById('settings-help-bar').classList.add('collapsed')">&times;</button>
    </div>

    <ul class="nav nav-pills settings-tabs" id="settings-tab-nav" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-security" data-bs-toggle="tab" data-bs-target="#pane-security" type="button" role="tab" aria-controls="pane-security" aria-selected="true">
                <i class="bi bi-shield-lock"></i><span data-i18n="settings.tab.security">Account Security</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-logging" data-bs-toggle="tab" data-bs-target="#pane-logging" type="button" role="tab" aria-controls="pane-logging" aria-selected="false">
                <i class="bi bi-journal-text"></i><span data-i18n="settings.tab.logging">Logging &amp; Persistence</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-system" data-bs-toggle="tab" data-bs-target="#pane-system" type="button" role="tab" aria-controls="pane-system" aria-selected="false">
                <i class="bi bi-info-circle"></i><span data-i18n="settings.tab.system">System Info</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-config" data-bs-toggle="tab" data-bs-target="#pane-config" type="button" role="tab" aria-controls="pane-config" aria-selected="false">
                <i class="bi bi-file-earmark-arrow-up-down"></i><span data-i18n="settings.tab.config">Import / Export</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-database" data-bs-toggle="tab" data-bs-target="#pane-database" type="button" role="tab" aria-controls="pane-database" aria-selected="false">
                <i class="bi bi-database"></i><span data-i18n="settings.tab.database">Database</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-ai" data-bs-toggle="tab" data-bs-target="#pane-ai" type="button" role="tab" aria-controls="pane-ai" aria-selected="false">
                <i class="bi bi-robot"></i><span data-i18n="settings.tab.ai">AI Assistant</span>
            </button>
        </li>
    </ul>

    <div class="tab-content settings-tab-content" id="settings-tab-content">

        <div class="tab-pane fade show active" id="pane-security" role="tabpanel" aria-labelledby="tab-security">
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--amber"><i class="bi bi-shield-lock"></i></span>
                        <span data-i18n="twofa.title">Two-Factor Authentication (2FA)</span>
                    </div>
                    <span id="twofa-status-badge" class="settings-status-badge" data-i18n="common.loading">Loading...</span>
                </div>
                @if (keycloakSso)
                {
                    <div class="settings-panel-body">Manage your password and multi-factor authentication in Keycloak.</div>
                }
                else
                {
                <div id="twofa-content" class="settings-panel-body">
                    <div class="loading-state">
                        <div class="loading-spinner"></div>
                        <div class="loading-text" data-i18n="common.loading">Loading...</div>
                    </div>
                </div>
                }
            </div>
        </div>


        <div class="tab-pane fade" id="pane-logging" role="tabpanel" aria-labelledby="tab-logging">

            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--blue"><i class="bi bi-database-check"></i></span>
                        <span data-i18n="settings.logging.group.persistence">Persistence &amp; Retention</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-grid">
                        <div class="settings-field">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="ls-persistence">
                                <label class="form-check-label" for="ls-persistence" data-i18n="settings.logging.persistenceEnabled">Log Persistence</label>
                            </div>
                            <div class="settings-field-desc" data-i18n="settings.logging.persistenceEnabled.desc">When disabled, logs are kept in memory only and not written to the database.</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-meta-retention" data-i18n="settings.logging.metaRetentionDays">Metadata retention (days)</label>
                            <input type="number" class="form-control" id="ls-meta-retention" min="1" max="365">
                            <div class="settings-field-hint">1–365 days</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-body-retention" data-i18n="settings.logging.bodyRetentionDays">Large-field retention (days)</label>
                            <input type="number" class="form-control" id="ls-body-retention" min="1" max="365">
                            <div class="settings-field-hint">1–365 days</div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--green"><i class="bi bi-file-earmark-text"></i></span>
                        <span data-i18n="settings.logging.group.bodyCapture">Request/Response Body Capture</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-grid">
                        <div class="settings-field">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="ls-req-body">
                                <label class="form-check-label" for="ls-req-body" data-i18n="settings.logging.requestBodyCapture">Request body capture</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="ls-resp-body">
                                <label class="form-check-label" for="ls-resp-body" data-i18n="settings.logging.responseBodyCapture">Response body capture</label>
                            </div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-max-body" data-i18n="settings.logging.maxBodyLength">Max body length (bytes)</label>
                            <input type="number" class="form-control" id="ls-max-body" min="1024" step="1024">
                            <div class="settings-field-hint">bytes</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-buffer" data-i18n="settings.logging.maxBodyBufferBytes">Body buffer (bytes)</label>
                            <input type="number" class="form-control" id="ls-buffer" min="1024" step="1024">
                            <div class="settings-field-hint">bytes</div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--amber"><i class="bi bi-funnel"></i></span>
                        <span data-i18n="settings.logging.group.sampling">Sampling &amp; Filtering</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-grid">
                        <div class="settings-field">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="ls-sampling">
                                <label class="form-check-label" for="ls-sampling" data-i18n="settings.logging.samplingEnabled">Enable sampling</label>
                            </div>
                            <div class="settings-field-desc" data-i18n="settings.logging.samplingEnabled.desc">Logs only a proportion of requests to reduce storage.</div>
                            <label class="form-label mt-2" for="ls-sampling-rate" data-i18n="settings.logging.samplingRate">Sampling rate (0.01 - 1.0)</label>
                            <input type="number" class="form-control" id="ls-sampling-rate" min="0.01" max="1" step="0.01">
                            <div class="settings-field-hint">0.01 - 1.0</div>
                        </div>
                        <div class="settings-field">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="ls-errors-only">
                                <label class="form-check-label" for="ls-errors-only" data-i18n="settings.logging.errorsOnly">Errors only</label>
                            </div>
                            <div class="settings-field-desc" data-i18n="settings.logging.errorsOnly.desc">Logs only requests with status code ≥ 400.</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="ls-min-level" data-i18n="settings.logging.minLogLevel">Minimum log level</label>
                            <select class="form-select" id="ls-min-level">
                                <option value="Trace" data-i18n="settings.logging.level.trace">Trace</option>
                                <option value="Information" data-i18n="settings.logging.level.information">Information</option>
                                <option value="Warning" data-i18n="settings.logging.level.warning">Warning</option>
                                <option value="Error" data-i18n="settings.logging.level.error">Error</option>
                                <option value="Critical" data-i18n="settings.logging.level.critical">Critical</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>


            <div class="settings-bottom-bar">
                <div class="settings-bottom-bar-left">
                    <span id="settings-customized-badge" class="settings-status-badge settings-status-badge--warning d-none" data-i18n="settings.logging.customizedBadge">Customized</span>
                </div>
                <div class="settings-bottom-bar-right">
                    <button class="btn btn-outline-secondary btn-sm" id="settings-reset-btn" onclick="SettingsModule.reset()">
                        <i class="bi bi-arrow-counterclockwise me-1"></i><span data-i18n="settings.logging.reset">Reset to Defaults</span>
                    </button>
                    <button class="btn btn-primary btn-sm" id="settings-save-btn" onclick="SettingsModule.save()">
                        <i class="bi bi-check-lg me-1"></i><span data-i18n="settings.logging.save">Save Log Settings</span>
                    </button>
                </div>
            </div>


            <div class="settings-panel settings-panel--muted">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--gray"><i class="bi bi-arrow-repeat"></i></span>
                        <span data-i18n="settings.logging.restartRequired">Restart Required</span>
                        <span class="settings-read-only-badge" data-i18n="settings.logging.restartRequired.badge">Read-only · appsettings.json</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-desc mb-3" data-i18n="settings.logging.restartRequired.desc">These options come from appsettings.json and require a restart to take effect.</div>
                    <div id="settings-restart-required" class="restart-required-grid"></div>
                </div>
            </div>
        </div>


        <div class="tab-pane fade" id="pane-system" role="tabpanel" aria-labelledby="tab-system">
            <div class="settings-panel">
                <div class="settings-panel-body" id="settings-system-content">
                    <div class="loading-state">
                        <div class="loading-spinner"></div>
                        <div class="loading-text" data-i18n="pluginPage.loading">Loading...</div>
                    </div>
                </div>
            </div>
        </div>


        <div class="tab-pane fade" id="pane-config" role="tabpanel" aria-labelledby="tab-config">

            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--green"><i class="bi bi-download"></i></span>
                        <span data-i18n="config.export">Export Config</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-desc mb-3" data-i18n="config.exportDesc">Export current gateway config as a JSON file</div>
                    <div class="mt-3">
                        <button class="btn btn-outline-success btn-sm" id="config-export-btn" onclick="SettingsModule.exportConfig()">
                            <i class="bi bi-download me-1"></i><span data-i18n="config.exportBtn">Export</span>
                        </button>
                    </div>
                </div>
            </div>


            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--amber"><i class="bi bi-upload"></i></span>
                        <span data-i18n="config.import">Import Config</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-desc mb-3" data-i18n="config.importDesc">Import gateway config from a JSON file</div>


                    <div id="config-import-dropzone" class="config-import-dropzone">
                        <input type="file" id="config-import-file" accept=".json,application/json" style="display:none;">
                        <div class="config-import-dropzone-content">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <span data-i18n="config.dropFile">Drop file here or click to select</span>
                            <span class="text-muted small" data-i18n="config.selectJsonFile">Please select a JSON file</span>
                        </div>
                    </div>


                    <div id="config-import-manifest" class="config-import-manifest d-none">
                        <div class="config-import-manifest-header">
                            <span class="config-import-manifest-title">
                                <i class="bi bi-clipboard-check"></i>
                                <span data-i18n="config.importManifest">Import Manifest</span>
                            </span>
                            <span id="config-import-summary" class="config-import-summary"></span>
                        </div>
                        <div class="config-import-manifest-body">
                            <div id="config-manifest-routes" class="config-manifest-section">
                                <div class="config-manifest-section-title">
                                    <i class="bi bi-signpost-2"></i>
                                    <span data-i18n="config.importManifestRoutes">Route Manifest</span>
                                    <span id="config-manifest-routes-count" class="badge bg-primary"></span>
                                </div>
                                <div id="config-manifest-routes-list" class="config-manifest-list"></div>
                            </div>
                            <div id="config-manifest-clusters" class="config-manifest-section">
                                <div class="config-manifest-section-title">
                                    <i class="bi bi-diagram-3"></i>
                                    <span data-i18n="config.importManifestClusters">Cluster Manifest</span>
                                    <span id="config-manifest-clusters-count" class="badge bg-info"></span>
                                </div>
                                <div id="config-manifest-clusters-list" class="config-manifest-list"></div>
                            </div>
                        </div>
                        <div class="config-import-manifest-desc" data-i18n="config.importManifestDesc">Review the configuration items above before proceeding</div>
                        <div class="config-import-manifest-actions">
                            <button class="btn btn-outline-secondary btn-sm" id="config-import-back" onclick="SettingsModule.resetImportFile()">
                                <i class="bi bi-arrow-left me-1"></i><span data-i18n="config.importManifestBack">Back</span>
                            </button>
                            <button class="btn btn-primary btn-sm" id="config-import-confirm" onclick="SettingsModule.confirmImportConfig()">
                                <i class="bi bi-check-lg me-1"></i><span data-i18n="config.importManifestContinue">Confirm Import</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="tab-pane fade" id="pane-database" role="tabpanel" aria-labelledby="tab-database">

            <div class="settings-panel settings-panel--muted">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--gray"><i class="bi bi-info-circle"></i></span>
                        <span data-i18n="settings.db.info">Database Info</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="db-info-grid">
                        <div class="db-info-item">
                            <span class="db-info-label" data-i18n="settings.db.fileName">File Name</span>
                            <span class="db-info-value" id="db-info-name">—</span>
                        </div>
                        <div class="db-info-item">
                            <span class="db-info-label" data-i18n="settings.db.fileSize">File Size</span>
                            <span class="db-info-value" id="db-info-size">—</span>
                        </div>
                    </div>
                </div>
            </div>


            <div class="db-actions-grid">

                <div class="settings-panel">
                    <div class="settings-panel-header">
                        <div class="settings-panel-title">
                            <span class="settings-panel-icon settings-panel-icon--cyan"><i class="bi bi-download"></i></span>
                            <span data-i18n="settings.db.download">Database Download</span>
                        </div>
                    </div>
                    <div class="settings-panel-body">
                        <div class="settings-field-desc mb-2" data-i18n="settings.db.downloadDesc">Directly copies the current database file, fast but may not include uncommitted WAL data</div>
                        <div class="db-feature-list">
                            <div class="db-feature-item">
                                <i class="bi bi-check2 text-success"></i>
                                <span data-i18n="settings.db.feat.fast">Fast, direct file copy</span>
                            </div>
                            <div class="db-feature-item">
                                <i class="bi bi-x text-danger"></i>
                                <span data-i18n="settings.db.feat.maybeInconsistent">May not include WAL data</span>
                            </div>
                            <div class="db-feature-item">
                                <i class="bi bi-x text-danger"></i>
                                <span data-i18n="settings.db.feat.noTimestamp">Filename has no timestamp</span>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-outline-secondary btn-sm" onclick="SettingsModule.downloadDatabase()">
                                <i class="bi bi-download me-1"></i><span data-i18n="settings.db.downloadBtn">Download Database</span>
                            </button>
                        </div>
                    </div>
                </div>


                <div class="settings-panel">
                    <div class="settings-panel-header">
                        <div class="settings-panel-title">
                            <span class="settings-panel-icon settings-panel-icon--green"><i class="bi bi-shield-check"></i></span>
                            <span data-i18n="settings.db.backup">Database Backup</span>
                        </div>
                    </div>
                    <div class="settings-panel-body">
                        <div class="settings-field-desc mb-2" data-i18n="settings.db.backupDesc">Creates a transactionally consistent snapshot using VACUUM INTO, WAL merged, ideal for long-term archiving</div>
                        <div class="db-feature-list">
                            <div class="db-feature-item">
                                <i class="bi bi-check2 text-success"></i>
                                <span data-i18n="settings.db.feat.consistent">Transactionally consistent snapshot</span>
                            </div>
                            <div class="db-feature-item">
                                <i class="bi bi-check2 text-success"></i>
                                <span data-i18n="settings.db.feat.walMerged">WAL logs merged into single file</span>
                            </div>
                            <div class="db-feature-item">
                                <i class="bi bi-check2 text-success"></i>
                                <span data-i18n="settings.db.feat.timestamp">Filename includes timestamp for versioning</span>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-outline-primary btn-sm" id="config-backup-btn" onclick="SettingsModule.backupDatabase()">
                                <i class="bi bi-shield-check me-1"></i><span data-i18n="settings.db.backupBtn">Backup Database</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>


            <div class="settings-panel settings-panel--muted">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--gray"><i class="bi bi-table"></i></span>
                        <span data-i18n="settings.db.comparison">Download vs Backup Comparison</span>
                    </div>
                </div>
                <div class="settings-panel-body p-0">
                    <table class="table table-sm mb-0 db-comparison-table">
                        <thead>
                            <tr>
                                <th data-i18n="settings.db.comp.feature">Feature</th>
                                <th data-i18n="settings.db.download">Database Download</th>
                                <th data-i18n="settings.db.backup">Database Backup</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-i18n="settings.db.comp.consistency">Data Consistency</td>
                                <td><i class="bi bi-dash text-warning"></i> <span data-i18n="settings.db.comp.maybe">Depends on WAL state</span></td>
                                <td><i class="bi bi-check2 text-success"></i> <span data-i18n="settings.db.comp.guaranteed">Transaction guaranteed</span></td>
                            </tr>
                            <tr>
                                <td data-i18n="settings.db.comp.wal">WAL Logs</td>
                                <td><i class="bi bi-x text-danger"></i> <span data-i18n="settings.db.comp.notIncluded">Not included</span></td>
                                <td><i class="bi bi-check2 text-success"></i> <span data-i18n="settings.db.comp.merged">Merged</span></td>
                            </tr>
                            <tr>
                                <td data-i18n="settings.db.comp.speed">Speed</td>
                                <td><i class="bi bi-check2 text-success"></i> <span data-i18n="settings.db.comp.fast">Fast</span></td>
                                <td><i class="bi bi-clock text-warning"></i> <span data-i18n="settings.db.comp.slower">Slightly slower</span></td>
                            </tr>
                            <tr>
                                <td data-i18n="settings.db.comp.filename">Filename</td>
                                <td><code>gateway-store.db</code></td>
                                <td><code>gateway-store-backup-{timestamp}.db</code></td>
                            </tr>
                            <tr>
                                <td data-i18n="settings.db.comp.scenario">Use Case</td>
                                <td data-i18n="settings.db.comp.quickInspect">Quick database inspection</td>
                                <td data-i18n="settings.db.comp.archiveRecovery">Long-term archiving, disaster recovery</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


        <div class="tab-pane fade" id="pane-ai" role="tabpanel" aria-labelledby="tab-ai">

            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--indigo"><i class="bi bi-robot"></i></span>
                        <span data-i18n="ai.title">AI Assistant Configuration</span>
                    </div>
                    <span id="ai-status-badge" class="settings-status-badge" data-i18n="ai.statusDisabled">Disabled</span>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="ai-enabled">
                            <label class="form-check-label" for="ai-enabled" data-i18n="ai.enabled">Enable AI Assistant</label>
                        </div>
                        <div class="settings-field-desc" data-i18n="ai.enabledDesc">When enabled, Dashboard will show the AI chat button</div>
                    </div>
                </div>
            </div>


            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--blue"><i class="bi bi-cloud"></i></span>
                        <span data-i18n="ai.provider">AI Provider</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="ai-provider-grid" id="ai-provider-grid">
                        <div class="ai-provider-card ai-provider-card--deepseek" data-provider="deepseek" data-base="https://api.deepseek.com/v1" data-model="deepseek-v4-flash">
                            <div class="ai-provider-name">DeepSeek</div>
                            <div class="ai-provider-model">V4-Flash</div>
                            <div class="ai-provider-tag ai-provider-tag--green">Recommended</div>
                        </div>
                        <div class="ai-provider-card ai-provider-card--openai" data-provider="openai" data-base="https://api.openai.com/v1" data-model="gpt-5.6-luna">
                            <div class="ai-provider-name">OpenAI</div>
