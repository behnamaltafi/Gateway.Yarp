@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "Notifications" : "Notifications";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div id="notifications-app">
    <div class="page-help-bar" id="notifications-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="notif.page.help">Notification management pushes gateway events and alerts via DingTalk, WeCom, Feishu, Slack, Discord, Telegram, Teams and more, with per-platform event subscriptions, cooldown deduplication and delivery history.</span>
        <button class="help-close" onclick="document.getElementById('notifications-help-bar').classList.add('collapsed')">&times;</button>
    </div>


    <div class="notif-kpi-row">
        <div class="notif-kpi">
            <span class="notif-kpi-icon" style="background:#dbeafe;color:#2563eb;"><i class="bi bi-broadcast"></i></span>
            <div class="notif-kpi-body">
                <div class="notif-kpi-value" id="notif-kpi-platforms">-</div>
                <div class="notif-kpi-label" data-i18n="notif.kpi.platforms">Connected Platforms</div>
                <div class="notif-kpi-trend text-muted" id="notif-kpi-platforms-sub"></div>
            </div>
        </div>
        <div class="notif-kpi">
            <span class="notif-kpi-icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-robot"></i></span>
            <div class="notif-kpi-body">
                <div class="notif-kpi-value" id="notif-kpi-endpoints">-</div>
                <div class="notif-kpi-label" data-i18n="notif.kpi.endpoints">Push Endpoints</div>
                <div class="notif-kpi-trend text-muted" id="notif-kpi-endpoints-sub"></div>
            </div>
        </div>
        <div class="notif-kpi">
            <span class="notif-kpi-icon" style="background:#ede9fe;color:#7c3aed;"><i class="bi bi-check2-square"></i></span>
            <div class="notif-kpi-body">
                <div class="notif-kpi-value" id="notif-kpi-events">-</div>
                <div class="notif-kpi-label" data-i18n="notif.kpi.events">Subscribed Events</div>
                <div class="notif-kpi-trend text-muted" id="notif-kpi-events-sub"></div>
            </div>
        </div>
        <div class="notif-kpi">
            <span class="notif-kpi-icon" style="background:#fef3c7;color:#d97706;"><i class="bi bi-graph-up-arrow"></i></span>
            <div class="notif-kpi-body">
                <div class="notif-kpi-value" id="notif-kpi-rate">-</div>
                <div class="notif-kpi-label" data-i18n="notif.kpi.rate">Delivery Success Rate</div>
                <div class="notif-kpi-trend text-muted" id="notif-kpi-rate-sub"></div>
            </div>
        </div>
    </div>

    <ul class="nav nav-pills settings-tabs" id="notif-tab-nav" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-notif-platforms" data-bs-toggle="tab" data-bs-target="#pane-notif-platforms" type="button" role="tab">
                <i class="bi bi-broadcast"></i><span data-i18n="notif.tab.platforms">Platforms</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-notif-events" data-bs-toggle="tab" data-bs-target="#pane-notif-events" type="button" role="tab">
                <i class="bi bi-check2-square"></i><span data-i18n="notif.tab.events">Event Subscriptions</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-notif-advanced" data-bs-toggle="tab" data-bs-target="#pane-notif-advanced" type="button" role="tab">
                <i class="bi bi-sliders"></i><span data-i18n="notif.tab.advanced">Advanced</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-notif-history" data-bs-toggle="tab" data-bs-target="#pane-notif-history" type="button" role="tab">
                <i class="bi bi-clock-history"></i><span data-i18n="notif.tab.history">Notification History</span>
            </button>
        </li>
    </ul>

    <div class="tab-content settings-tab-content" id="notif-tab-content">

        <div class="tab-pane fade show active" id="pane-notif-platforms" role="tabpanel" aria-labelledby="tab-notif-platforms">
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--amber"><i class="bi bi-broadcast"></i></span>
                        <span data-i18n="notif.platforms.title">Notification Platforms</span>
                    </div>
                    <span id="notif-platforms-summary" class="settings-status-badge" data-i18n="common.loading">Loading...</span>
                </div>
                <div class="settings-panel-body">
                    <div id="notif-platform-cards" class="notif-master-detail">
                        <div class="loading-state">
                            <div class="loading-spinner"></div>
                            <div class="loading-text" data-i18n="common.loading">Loading...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="tab-pane fade" id="pane-notif-events" role="tabpanel" aria-labelledby="tab-notif-events">
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--blue"><i class="bi bi-check2-square"></i></span>
                        <span data-i18n="notif.events.title">Event Subscription Matrix</span>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <span id="notif-events-mode" class="settings-status-badge"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="notif-events-default-btn" data-i18n="notif.events.followGlobal">Follow Global</button>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-desc mb-3" data-i18n="notif.events.help">Check the events each platform should receive. Platforms with no explicit selection ("Follow Global") only receive config-change events from the global event list.</div>
                    <div class="table-responsive notif-events-scroll">
                        <table class="table table-sm align-middle notif-events-table">
                            <thead>
                                <tr id="notif-events-head-row">
                                    <th data-i18n="notif.events.eventColumn">Event</th>
                                </tr>
                            </thead>
                            <tbody id="notif-events-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>


        <div class="tab-pane fade" id="pane-notif-advanced" role="tabpanel" aria-labelledby="tab-notif-advanced">
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--green"><i class="bi bi-sliders"></i></span>
                        <span data-i18n="notif.advanced.title">Delivery Policy</span>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="settings-field-grid">
                        <div class="settings-field">
                            <label class="form-label" for="notif-cooldown" data-i18n="notif.advanced.cooldown">Cooldown (seconds)</label>
                            <input type="number" class="form-control" id="notif-cooldown" min="0" max="3600">
                            <div class="settings-field-hint" data-i18n="notif.advanced.cooldown.hint">Same platform + event + target is pushed only once within this window to prevent alert storms (0 = no cooldown).</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="notif-retry" data-i18n="notif.advanced.retry">Retry Count on Failure</label>
                            <input type="number" class="form-control" id="notif-retry" min="0" max="5">
                            <div class="settings-field-hint" data-i18n="notif.advanced.retry.hint">Exponential backoff retry: 1s / 4s / 16s.</div>
                        </div>
                        <div class="settings-field">
                            <label class="form-label" for="notif-timeout" data-i18n="notif.advanced.timeout">Request Timeout (seconds)</label>
                            <input type="number" class="form-control" id="notif-timeout" min="3" max="60">
                            <div class="settings-field-hint" data-i18n="notif.advanced.timeout.hint">HTTP timeout for a single delivery.</div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="notif-clear-cooldown-btn">
                            <i class="bi bi-arrow-repeat me-1"></i><span data-i18n="notif.advanced.clearCooldown">Clear Cooldown</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <div class="tab-pane fade" id="pane-notif-history" role="tabpanel" aria-labelledby="tab-notif-history">
            <div class="settings-panel">
                <div class="settings-panel-header">
                    <div class="settings-panel-title">
                        <span class="settings-panel-icon settings-panel-icon--blue"><i class="bi bi-clock-history"></i></span>
                        <span data-i18n="notif.history.title">Recent Deliveries</span>
                    </div>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <span id="notif-history-summary" class="settings-status-badge"></span>
                        <div class="btn-group btn-group-sm" id="notif-history-filters" role="group" aria-label="filter">
                            <button type="button" class="btn btn-outline-secondary active" data-filter="all" data-i18n="notif.history.filter.all">All</button>
                            <button type="button" class="btn btn-outline-secondary" data-filter="success" data-i18n="notif.history.filter.success">Success</button>
                            <button type="button" class="btn btn-outline-secondary" data-filter="failed" data-i18n="notif.history.filter.failed">Failed</button>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="notif-history-refresh-btn"><i class="bi bi-arrow-clockwise me-1"></i><span data-i18n="common.refresh">Refresh</span></button>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="notif-history-clear-btn"><i class="bi bi-trash3 me-1"></i><span data-i18n="notif.history.clear">Clear</span></button>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th data-i18n="notif.history.time">Time</th>
                                    <th data-i18n="notif.history.platform">Platform</th>
                                    <th data-i18n="notif.history.event">Event</th>
                                    <th data-i18n="notif.history.target">Target</th>
                                    <th data-i18n="notif.history.status">Status</th>
                                    <th data-i18n="notif.history.duration">Duration</th>
                                    <th data-i18n="notif.history.error">Error</th>
                                </tr>
                            </thead>
                            <tbody id="notif-history-body">
                                <tr><td colspan="7" class="text-center text-muted py-4" data-i18n="notif.history.empty">No records</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>

@section Scripts {
@await Html.PartialAsync("_DashboardPageInit")
<script>
    (function() {
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();
    })();
</script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-notifications.js"></script>
}
