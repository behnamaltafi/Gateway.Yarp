@using Aneiang.Yarp.Plugin.ProxyLog.Models
@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "Plugin Management" : "Plugin Management";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div id="plugins-app">
    <div class="page-help-bar" id="plugins-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="page.help.plugins">Plugins provide extended capabilities (rate limiting, WAF, retry, etc.). Enable globally, then bind to routes or clusters.</span>
        <button class="help-close" onclick="document.getElementById('plugins-help-bar').classList.add('collapsed')">&times;</button>
    </div>
    <div class="card-panel mb-4">
        <div class="card-header">
            <span><i class="bi bi-puzzle me-2" style="color:#8b5cf6;"></i><span data-i18n="plugin.title">Plugin Management</span></span>
            <div class="card-header-actions">
                <span id="plugin-refresh-time" class="refresh-badge"></span>
                <button class="btn btn-sm btn-outline-secondary" onclick="PluginModule.resetAll()" data-i18n-title="plugin.resetAll" title="Enable All">
                    <i class="bi bi-check-all"></i> <span data-i18n="plugin.resetAll">Enable All</span>
                </button>
                <button class="btn btn-sm btn-outline-secondary btn-icon-only" onclick="PluginModule.load()" data-i18n-title="index.btn.refresh" title="Refresh" aria-label="Refresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
        <div id="plugin-content" class="card-body">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="plugin.loading">Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@{ var v = typeof(LogEntry).Assembly.GetName().Version?.ToString() ?? DateTime.Now.Ticks.ToString(); }
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-plugins.js?v=@v"></script>

@await Html.PartialAsync("_DashboardPageInit")

<script>
    (async function() {
        if (window.DashboardUtils) DashboardUtils.init();
        if (window.DashboardApi) DashboardApi.init();
        if (window.DashboardState) DashboardState.init();
        if (window.DashboardI18n) DashboardI18n.init();
        if (window.DashboardStorage) DashboardStorage.init();
        if (window.DashboardModals) DashboardModals.init();
        if (window.DashboardEvents) DashboardEvents.setup();
        if (window.DashboardApp && window.DashboardApp.modules && window.DashboardApp.modules.plugin) {
            await DashboardApp.modules.plugin.init();
        }
        await PluginModule.load();
        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();
</script>
}
