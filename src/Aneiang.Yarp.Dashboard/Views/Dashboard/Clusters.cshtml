@using Aneiang.Yarp.Plugin.ProxyLog.Models
@{
    ViewData["Title"] = ((ViewBag.Locale as string) == "en-US") ? "Clusters" : "Clusters";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- Cluster panel -->
<div class="page-help-bar" id="clusters-help-bar">
    <i class="bi bi-info-circle"></i>
    <span class="help-text" data-i18n="page.help.clusters">A cluster is a group of backend service nodes. Routes forward requests to specified clusters. Click a row to expand node details and bound plugin capabilities.</span>
    <button class="help-close" onclick="document.getElementById('clusters-help-bar').classList.add('collapsed')">&times;</button>
</div>
<!-- Proxy config apply-error hint bar (populated by dashboard-clusters.js) -->
<div id="cluster-config-alert" class="config-alert-bar" style="display:none;" role="alert"></div>
<div id="cluster-panel" class="card-panel mb-4">
    <div class="card-header">
        <span><i class="bi bi-hdd-stack me-2" style="color:#3b82f6;"></i><span data-i18n="index.cluster.title">Cluster &amp; Destination Status</span></span>
        <div class="card-header-actions">
            <div id="cluster-batch-bar" class="batch-bar" style="display:none;">
                <span class="batch-count"><i class="bi bi-check2-square"></i><strong id="cluster-batch-count">0</strong><span data-i18n="batch.selected"> selected</span></span>
                <span class="batch-bar-divider" aria-hidden="true"></span>
                <div class="batch-bar-actions">
                    <button class="btn btn-sm batch-action" onclick="ClustersModule.batchBindPlugin()"><i class="bi bi-plug"></i><span data-i18n="batch.bindPlugin">Batch Bind Plugin</span></button>
                    <button class="btn btn-sm batch-action" onclick="ClustersModule.exportSelected()"><i class="bi bi-download"></i><span data-i18n="batch.export">Export Selected</span></button>
                    <button class="btn btn-sm batch-action batch-action-danger" onclick="ClustersModule.batchDelete()"><i class="bi bi-trash"></i><span data-i18n="batch.delete">Batch Delete</span></button>
                </div>
                <button class="btn btn-sm batch-dismiss" onclick="ClustersModule.clearBatch()" title="Clear selection" aria-label="Clear selection"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div class="d-flex align-items-center" style="gap:6px 16px;white-space:nowrap;">
            <span class="refresh-badge" id="cluster-refresh-time"></span>
            <span class="refresh-badge"><span data-i18n="index.cluster.showing">Showing </span><strong id="cluster-display-count">0</strong><span data-i18n="index.cluster.of"> / </span><span id="cluster-total-count">0</span><span data-i18n="index.cluster.entries"> entries</span></span>
        </div>
    </div>

    <!-- Filter toolbar container -->
    <div id="cluster-filter-container"></div>

    <!-- Table view -->
    <div id="cluster-table-view">
        <div class="table-responsive">
            <table class="table table-hover table-striped-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:36px;text-align:center;"><input type="checkbox" id="cluster-select-all" onclick="ClustersModule.toggleSelectAll(this.checked)"></th>
                        <th style="width:38px"></th>
                        <th><span data-i18n="index.cluster.th.name">Cluster</span></th>
                        <th style="width:90px"><span data-i18n="index.source.filter">Source</span></th>
                        <th style="width:90px"><span data-i18n="index.cluster.health.filter">Health</span></th>
                        <th style="width:80px"><span data-i18n="index.cluster.destCount">destinations</span></th>
                        <th style="width:110px"><span data-i18n="index.cluster.loadBalancing">Load Balancing</span></th>
                        <th style="width:160px"><span data-i18n="index.cluster.th.actions">Actions</span></th>
                    </tr>
                </thead>
                <tbody id="cluster-tbody">
                    <tr><td colspan="8" class="text-center py-4">
                        <div style="padding:4px 0;">
                            <div class="skeleton skeleton-line long"></div>
                            <div class="skeleton skeleton-line medium"></div>
                            <div class="skeleton skeleton-line short"></div>
                        </div>
                    </td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
@{ var v = typeof(LogEntry).Assembly.GetName().Version?.ToString() ?? DateTime.Now.Ticks.ToString(); }
<script src="/_content/Aneiang.Yarp.Dashboard/js/editors/dashboard-schema-service.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/editors/dashboard-schema-validator.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/editors/lazy-monaco-loader.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/editors/dashboard-monaco-editor.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/editors/dashboard-config-editor.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/editors/dashboard-form-builder.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/editors/dashboard-diff-panel.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/editors/dashboard-validation-panel.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-batch-plugin.js?v=@v"></script>
<script src="/_content/Aneiang.Yarp.Dashboard/js/modules/dashboard-clusters.js?v=@v"></script>
<!-- Page config (shared scripts now in _DashboardLayout.cshtml) -->
@await Html.PartialAsync("_DashboardPageInit")

<script>
    (async function() {
        DashboardApi.init();
        if (window.DashboardApp?.modules?.clusters?.init) await DashboardApp.modules.clusters.init();
        if (window.DashboardApp?.modules?.clusters?.loadClusters) await DashboardApp.modules.clusters.loadClusters();
        document.dispatchEvent(new CustomEvent('dashboard:ready'));
    })();

    window.clustersRefresh = async function(btn) {
        var originalText = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-arrow-clockwise spin me-1"></i>';
        btn.disabled = true;
        try {
            await window.DashboardApp?.modules?.clusters?.loadClusters?.();
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    };
</script>
}
