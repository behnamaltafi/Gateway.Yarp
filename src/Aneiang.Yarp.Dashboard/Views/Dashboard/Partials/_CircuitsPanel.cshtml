@* Partial: Circuits monitor panel (no config sub-panel - managed by PluginCenter) *@
<div id="circuits-app">
    <div class="page-help-bar" id="circuits-help-bar">
        <i class="bi bi-info-circle"></i>
        <span class="help-text" data-i18n="page.help.circuits">Circuit breaker monitoring shows the breaker state for each cluster. When backend services fail, the breaker trips to protect the system.</span>
        <button class="help-close" onclick="document.getElementById('circuits-help-bar').classList.add('collapsed')">&times;</button>
    </div>
    <div class="plugin-hint-banner" id="circuit-plugin-hint">
        <i class="bi bi-info-circle"></i>
        <span data-i18n="common.pluginNotConfigured">Plugin not configured, data may be empty</span>
        <a href="/@ViewBag.DashboardRoutePrefix/plugin-center#circuit-breaker" class="plugin-hint-link" data-i18n="common.goPluginConfig">Go to configuration <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
    <div class="pc-panel-head">
        <div class="pc-panel-title"><i class="bi bi-lightning-charge me-2" style="color:#f59e0b;"></i><span data-i18n="circuit.title">Circuit Breaker Status</span></div>
        <div class="pc-panel-actions">
            <span id="circuit-refresh-time" class="refresh-badge"></span>
            <button class="pr-refresh-btn" onclick="CircuitModule.load()" data-i18n-title="index.btn.refresh" title="Refresh" aria-label="Refresh">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button class="btn btn-sm btn-outline-danger" onclick="CircuitModule.resetAll()" data-i18n-title="circuit.reset" title="Reset">
                <i class="bi bi-x-circle"></i> <span data-i18n="circuit.reset">Reset</span>
            </button>
        </div>
    </div>
    <div id="circuit-content">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <div class="loading-text" data-i18n="circuit.loading">Loading...</div>
            </div>
        </div>
    </div>
    <div class="pc-feature-config" data-plugin="circuits"></div>
</div>
